// Prisma schema for RePrice - platform connecting supermarkets and consumers
// to sell products close to expiration at reduced prices.
//
// Os nomes das tabelas/colunas (@@map / @map) seguem o banco do Netlify
// (users, companies, products, reservations, colunas em snake_case),
// para usar o mesmo banco que já está no ar sem perder dados.
// As tabelas são criadas por scripts/setup-db.mjs (CREATE TABLE IF NOT EXISTS).

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x = ambiente das funções do Netlify (Node 20+)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Consumer account
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  city      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  reservations Reservation[]

  @@map("users")
}

// Company / supermarket account
model Company {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  cnpj      String?
  phone     String?
  city      String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  products Product[]

  @@map("companies")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  category       String
  originalPrice  Float    @map("original_price")
  promoPrice     Float    @map("promo_price")
  expirationDate DateTime @map("expiration_date")
  quantity       Int
  imageUrl       String?  @map("image_url")
  status         String   @default("ACTIVE") // ACTIVE | RESERVED | SOLD_OUT | EXPIRED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reservations Reservation[]

  @@map("products")
}

model Reservation {
  id         String   @id @default(cuid())
  quantity   Int
  status     String   @default("PENDING") // PENDING | READY | DELIVERED | CANCELLED
  pickupCode String   @default(cuid()) @map("pickup_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  companyId String @map("company_id")

  @@map("reservations")
}

// Perguntas frequentes (aba Suporte). Gerenciadas pela área de dev.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("faqs")
}

// Mensagens enviadas pelo formulário "Fale com a gente" da aba Suporte.
model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN | RESOLVED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("support_messages")
}
