# URL do banco Postgres. Na Vercel (ou no Netlify), cadastre em
# Settings > Environment Variables (nome: DATABASE_URL).
# Se o site usa o Netlify Database, as variáveis NETLIFY_DB_URL /
# NETLIFY_DATABASE_URL também são aceitas automaticamente.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Área de dev (aba Suporte > "acesso restrito")
DEV_EMAIL="seu-email@exemplo.com"
DEV_PASSWORD="uma-senha-forte"

# Chave da planilha do Google (/api/export/products?key=...)
EXPORT_KEY="invente-uma-chave"

# Opcional: segredo para assinar o login. Se não existir, é derivado da DATABASE_URL.
# SESSION_SECRET="texto-aleatorio-grande"

# Chat de suporte com IA (Groq): https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
# Opcional: modelo do Groq (padrão: openai/gpt-oss-20b, o mais barato)
# GROQ_MODEL="openai/gpt-oss-20b"
